# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env

# --- Tailscale (required) -----------------------------------------------------
# OAuth client secret (tskey-client-...) with the `auth_keys` write scope and
# TS_TAGS among its tags. A plain auth key (tskey-auth-...) also works.
# Create it non-ephemeral: the Caddyfile's `ephemeral false` can't undo an
# ephemeral key.
TS_AUTHKEY=

# Your tailnet's MagicDNS suffix (admin console -> DNS), e.g. tail1234.ts.net
TS_TAILNET=

# Machine name on the tailnet. Kuma is served at https://<TS_HOSTNAME>.<TS_TAILNET>
TS_HOSTNAME=uptime

# ACL tag to register under. Must be in your policy's tagOwners and, for an
# OAuth client, in its allowed tags.
TS_TAGS=tag:container

# --- Optional -----------------------------------------------------------------
# Docker socket path (rootless Docker: /run/user/1000/docker.sock).
#DOCKER_SOCKET=/var/run/docker.sock

# Pin the caddy-tailscale plugin to a commit SHA for reproducible builds.
#CADDY_TAILSCALE_REF=main
